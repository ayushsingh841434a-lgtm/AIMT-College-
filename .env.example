# ============================================================
# AIMT College Management System — environment variables
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# NEVER commit a real .env file.
# ============================================================

# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aimt_cms?schema=public"

# Initial admin account created by the seed script.
# Change the password immediately after first login.
ADMIN_EMAIL="admin@aimt.edu"
ADMIN_PASSWORD="ChangeMe123!"

# Demo accounts created by the seed script (development only).
# Format: email addresses used for the demo MANAGEMENT and STUDENT accounts.
# The seed script also sets known demo passwords — see README (demo accounts).
DEMO_MANAGER_EMAIL="manager@aimt.edu"
DEMO_STUDENT_EMAIL="student@aimt.edu"

# When true, /api/auth/forgot-password returns the reset URL in its JSON
# response. Intended ONLY for local demos where no email server is set up.
# Keep false (or unset) in any real deployment.
ALLOW_DEMO_RESET_LINKS="false"

# Used to build absolute reset-password links in demo mode.
APP_URL="http://localhost:3000"

# Set by the platform in production (e.g. Vercel sets NODE_ENV=production).
NODE_ENV="development"
